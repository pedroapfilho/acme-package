{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "oxlint.config.ts",
    "**/tsdown.config.ts",
    "apps/demo-vite/src/main.tsx",
    "apps/docs/app/layout.tsx",
    "apps/docs/source.config.ts",
    "apps/docs/components/ui/*.tsx"
  ],
  "ignorePatterns": ["apps/docs/content/**", "apps/docs/next-env.d.ts", ".github/ci/*.mjs"],
  "ignoreExports": [
    {
      "file": "apps/docs/app/**/route.ts",
      "exports": ["generateStaticParams"]
    }
  ],
  "ignoreDependencies": ["@shadcn/lint", "@vitest/coverage-v8", "jsdom", "react-dom", "zod"],
  "typeAware": {
    "enabled": true,
    "require": "best-effort"
  },
  "rules": {
    "private-type-leaks": "off"
  }
}
