{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": ["**/tsdown.config.ts", "apps/docs/components/ui/*.tsx"],
  "ignorePatterns": ["apps/docs/content/**", ".github/ci/*.mjs"],
  "ignoreExports": [
    {
      "file": "apps/docs/app/**/route.ts",
      "exports": ["generateStaticParams"]
    }
  ],
  "ignoreDependencies": ["@shadcn/lint", "@vitest/coverage-v8", "jsdom", "zod"],
  "typeAware": {
    "enabled": true,
    "require": "best-effort"
  },
  "rules": {
    "private-type-leaks": "off"
  },
  "boundaries": {
    "zones": [
      {
        "name": "app",
        "autoDiscover": ["apps"]
      },
      {
        "name": "package",
        "patterns": ["packages/**"]
      }
    ],
    "rules": [
      {
        "from": "package",
        "allow": ["package"]
      },
      {
        "from": "app",
        "allow": ["package"]
      }
    ]
  }
}
