{
  "name": "docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "portless run --name acme-package.docs next dev --turbopack",
    "build": "next build",
    "start": "next start -p 4000",
    "postinstall": "fumadocs-mdx",
    "typecheck": "fumadocs-mdx && tsc --noEmit",
    "lint": "oxlint app lib components proxy.ts next.config.ts source.config.ts mdx-components.tsx",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "clean": "rm -rf .next .source node_modules"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "fumadocs-core": "^16.15.5",
    "fumadocs-mdx": "^15.4.0",
    "fumadocs-ui": "^16.15.5",
    "lucide-react": "^1.40.0",
    "next": "^16.3.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@next/playwright": "16.3.4",
    "@playwright/test": "^1.63.0",
    "@repo/config-vitest": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.4.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
